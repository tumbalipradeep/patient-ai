# ============================================================
# AI Patient Case-Taking System - Environment Variables
# Copy this file to .env and fill in production values.
# NEVER commit .env to version control.
# ============================================================

# Database Configuration
DATABASE_URL=jdbc:postgresql://localhost:5432/patientcase
DATABASE_USERNAME=patientcase
DATABASE_PASSWORD=your_secure_password_here

# Server Configuration
SERVER_PORT=8080

# Document Storage
APP_DOCUMENT_STORAGE_PATH=/var/patientcase/documents

# Spring Profile (dev, prod)
SPRING_PROFILES_ACTIVE=dev
